# Namecheap Private Email — admin@bravohcs.com
# Setup: reference/namecheap-private-email-setup.md
# Webmail: https://privateemail.com/
SMTP_HOST=mail.privateemail.com
SMTP_USER=admin@bravohcs.com
SMTP_PASSWORD=

# 465 for implicit TLS (default), or 587 for STARTTLS. Port 25 is blocked on Vercel.
SMTP_PORT=465

# From address on outgoing mail. Must be the authenticated mailbox or one of its
# aliases, otherwise most providers reject the message. Defaults to SMTP_USER.
MAIL_FROM_ADDRESS=

# Where form submissions are delivered. Defaults to company.email when unset.
CONTACT_TO_EMAIL=admin@bravohcs.com

# Optional — Cloudflare Turnstile (Forms > turnstile in Cloudflare dashboard)
# When both keys are set, the widget appears and the API rejects submissions without a valid token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional — Upstash Redis REST API for per-IP form rate limiting (5 submissions / hour)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
